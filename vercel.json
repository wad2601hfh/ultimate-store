{
  "functions": {
    "backend/api/*.php": { "runtime": "vercel-php@0.6.0" }
  },
  "routes": [
    { 
      "src": "/backend/api/(.*)", 
      "dest": "/backend/api/$1" 
    },
    { 
      "src": "/", 
      "dest": "/public/index.html" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/public/$1" 
    }
  ]
}